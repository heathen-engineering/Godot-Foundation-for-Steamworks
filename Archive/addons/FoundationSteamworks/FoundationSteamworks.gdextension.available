[configuration]
entry_symbol = "foundation_steam_init"
compatibility_minimum = 4.6

[libraries]

windows.debug.x86_64   = "res://addons/FoundationSteamworks/bin/libFoundationSteamworks.windows.debug.x86_64.dll"
windows.release.x86_64 = "res://addons/FoundationSteamworks/bin/libFoundationSteamworks.windows.release.x86_64.dll"

linux.debug.x86_64   = "res://addons/FoundationSteamworks/bin/libFoundationSteamworks.linux.debug.x86_64.so"
linux.release.x86_64 = "res://addons/FoundationSteamworks/bin/libFoundationSteamworks.linux.release.x86_64.so"

macos.debug.x86_64   = "res://addons/FoundationSteamworks/bin/libFoundationSteamworks.macos.debug.x86_64.dylib"
macos.release.x86_64 = "res://addons/FoundationSteamworks/bin/libFoundationSteamworks.macos.release.x86_64.dylib"

; SteamworksSubsystem (a real gameframework::Subsystem) needs the shared
; gameframework runtime loaded so it shares SubsystemManager::instance()
; with FoundationGameFramework and every other gem — see that repo's
; README, "The linking model". Declared explicitly so this doesn't depend
; on extension load order.
[dependencies]

windows.debug.x86_64 = {
  "res://addons/FoundationGameFramework/bin/libgameframework.windows.debug.x86_64.dll": ""
}
windows.release.x86_64 = {
  "res://addons/FoundationGameFramework/bin/libgameframework.windows.release.x86_64.dll": ""
}
linux.debug.x86_64 = {
  "res://addons/FoundationGameFramework/bin/libgameframework.linux.debug.x86_64.so": ""
}
linux.release.x86_64 = {
  "res://addons/FoundationGameFramework/bin/libgameframework.linux.release.x86_64.so": ""
}
macos.debug.x86_64 = {
  "res://addons/FoundationGameFramework/bin/libgameframework.macos.debug.x86_64.dylib": ""
}
macos.release.x86_64 = {
  "res://addons/FoundationGameFramework/bin/libgameframework.macos.release.x86_64.dylib": ""
}
